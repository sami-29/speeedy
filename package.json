{
	"name": "speeedy",
	"private": true,
	"version": "2.0.0",
	"type": "module",
	"packageManager": "pnpm@12.11.2",
	"engines": {
		"node": ">=22.22.0"
	},
	"scripts": {
		"build": "pnpm -r --if-present build",
		"lint": "biome check . && pnpm -r --if-present lint",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
		"test:workspace": "node --test test/workspace.test.ts test/app-shell.test.ts",
		"test:unit": "pnpm test:workspace && pnpm -r --if-present test:unit",
		"test:worker": "pnpm --filter @speeedy/worker test",
		"e2e": "pnpm -r --if-present e2e"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@types/node": "22.20.5",
		"typescript": "6.0.3"
	}
}
