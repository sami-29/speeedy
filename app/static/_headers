# Cloudflare Pages preview builds (one host per branch or deploy) must not be indexed.
# The production host (the bare project domain) is not matched here, so main stays indexable.
# Unverified until a preview is deployed: that the wildcard matches branch preview hosts.
https://*.speeedy.pages.dev/*
  X-Robots-Tag: noindex

# App routes are client-only and noindex. Robots.txt must not block them: crawlers have to
# fetch the page to see this header and the matching <meta name="robots">.
# /s also sends no Referer: a Share Link's text lives in the fragment, which browsers already
# strip from referrers, so this is a second guard.
/reader
  X-Robots-Tag: noindex
/library
  X-Robots-Tag: noindex
/stats
  X-Robots-Tag: noindex
/training
  X-Robots-Tag: noindex
/s
  X-Robots-Tag: noindex
  Referrer-Policy: no-referrer
/account/*
  X-Robots-Tag: noindex

# Cross-origin isolation, only where the on-device voice runs threaded WASM. Never on other
# pages: handoff, checkout return and share flows need their window opener.
/reader
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
/reader/*
  X-Robots-Tag: noindex
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
# A dedicated worker takes its embedder policy from its own script, so the voice worker (and
# the WASM threads it starts from the same file) needs COEP to keep the isolation.
/_app/immutable/workers/*
  Cross-Origin-Embedder-Policy: credentialless
