{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/*.md",
			"!pnpm-lock.yaml",
			"!app/static",
			"!app/brand",
			"!packages/parsers/test/fixtures"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					}
				}
			}
		},
		{
			"includes": ["app/src/app.css"],
			"linter": {
				"rules": { "complexity": { "noImportantStyles": "off" } }
			}
		},
		{
			"includes": ["app/src/app.html"],
			"linter": { "rules": { "a11y": { "useValidLang": "off" } } }
		}
	]
}
